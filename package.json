    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "expo": "~55.0.15",
    "expo-auth-session": "^55.0.15",
    "expo-camera": "~55.0.15",
    "expo-constants": "~55.0.14",
    "expo-dev-client": "~55.0.32",
    "expo-device": "~55.0.15",
    "expo-file-system": "~55.0.17",
